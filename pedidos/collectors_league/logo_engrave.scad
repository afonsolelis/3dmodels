// Logo centred on the origin, d mm across.
module logo_2d(d) {
    s = d / logo_grid;
    scale([s, s]) translate([-logo_grid / 2, -logo_grid / 2])
        for (r = logo_rects) translate([r[0], r[1]]) square([r[2] + 0.01, r[3] + 0.01]);
}
